<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultmessages='true' b:layoutsversion='3' b:responsive='true' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
  <head>
    <meta content='width=device-width, initial-scale=1' name='viewport'/>
    <title><data:blog.pageTitle/></title>
    
    <!-- SEO META TAGS -->
    <meta content='Portofolio dan Arsip Pemikiran Fakrullah Maulana (Bang Maulana). Eksplorasi teknologi, desain, dan narasi visual dari Bang Maul.' name='description'/>
    <meta content='Fakrullah Maulana, Bang Maulana, Bang Maul, Arsitek Visual, Teknologi Kreatif, Blogger Indonesia' name='keywords'/>
    <meta content='Fakrullah Maulana' name='author'/>
    <link expr:href='data:blog.url' rel='canonical'/>
    
    <!-- Tailwind CSS -->
    <script src='https://cdn.tailwindcss.com'/>
    
    <!-- Google Fonts -->
    <link href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap' rel='stylesheet'/>
    
    <!-- Lucide Icons -->
    <script src='https://unpkg.com/lucide@latest'/>

    <b:skin><![CDATA[
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #0a0a0a;
        color: #ffffff;
        margin: 0;
        padding: 0;
        scroll-behavior: smooth;
      }
      #navbar-iframe, .navbar { display: none !important; }
      
      .post-body {
        color: #1a1a1a;
        font-size: 1.1rem;
        line-height: 1.8;
        text-align: justify;
      }
      .post-body img {
        max-width: 100%;
        height: auto;
        border-radius: 1rem;
        margin: 1.5rem 0;
      }
      .img-placeholder {
        background: linear-gradient(45deg, #1a1a1a, #2a2a2a);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #444;
      }
      
      .donation-card-modern {
        background: #ffffff;
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }
      .donation-card-modern:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
      }

      .service-card {
        background: #0a0a0a;
        color: #ffffff;
        border: 1px solid rgba(255,255,255,0.1);
        transition: all 0.5s ease;
      }
      .service-card:hover {
        border-color: #ef4444;
        box-shadow: 0 0 30px rgba(239, 68, 68, 0.1);
      }
    ]]></b:skin>
  </head>

  <body class='bg-[#0a0a0a] text-white selection:bg-red-600/30'>
    
    <!-- Navigasi Utama (Sticky) -->
    <nav class='fixed top-0 w-full z-50 transition-all duration-300 px-6 md:px-12 py-5 flex justify-between items-center bg-transparent' id='main-nav'>
      <div class='text-lg font-black tracking-tighter uppercase italic'>
        <a class='flex items-center gap-1' href='/'>FM<span class='text-red-600'>.</span></a>
      </div>
      
      <!-- Menu Navigasi Sesuai Urutan Baru -->
      <div class='flex items-center gap-6 md:gap-10'>
        <div class='hidden md:flex items-center gap-8 mr-2'>
          <a class='text-[10px] font-black uppercase tracking-[0.2em] hover:text-red-600 transition-colors italic' expr:href='data:blog.homepageUrl'>Beranda</a>
          <a class='text-[10px] font-black uppercase tracking-[0.2em] hover:text-red-600 transition-colors italic' href='/p/tentang.html'>Tentang</a>
          <a class='text-[10px] font-black uppercase tracking-[0.2em] hover:text-red-600 transition-colors italic' href='/p/produk-dan-jasa.html'>Produk &amp; Jasa</a>
        </div>

        <div class='flex items-center'>
          <!-- Tombol Jelajah Arsip dengan warna merah yang tegas -->
          <a class='text-[9px] tracking-[0.2em] font-black bg-red-600 text-white border border-red-600 px-6 py-2.5 rounded-full hover:bg-white hover:text-black hover:border-white transition-all duration-300 uppercase italic shadow-lg shadow-red-600/20' href='/search?max-results=50'>JELAJAH ARSIP</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <b:if cond='data:view.isHomepage and !data:view.isSearch'>
      <section class='relative min-h-[95vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden'>
        <div class='absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-red-600/5 blur-[140px] rounded-full z-0'/>
        
        <div class='relative z-10 space-y-12 max-w-7xl w-full'>
          <div class='flex flex-nowrap items-center justify-center gap-x-4 md:gap-x-8 uppercase italic font-black tracking-tighter animate-in fade-in slide-in-from-bottom-12 duration-1000'>
            <span class='text-[8.5vw] md:text-[5.5rem] leading-none whitespace-nowrap'>FAKRULLAH</span>
            <div class='relative inline-block'>
              <div class='absolute -inset-3 md:-inset-5 border-2 border-red-600/40 rounded-full scale-110 -rotate-3 animate-pulse'/>
              <span class='text-[8.5vw] md:text-[5.5rem] leading-none text-red-600 relative z-10 whitespace-nowrap'>MAULANA</span>
            </div>
          </div>
          
          <div class='flex flex-col items-center gap-8 animate-in fade-in slide-in-from-bottom-4 duration-1000 delay-500'>
            <div class='h-[1px] w-32 bg-white/20'/>
            <div class='space-y-4 max-w-3xl'>
              <p class='text-lg md:text-2xl font-light leading-relaxed text-white/90'>
                Memastikan Anda tetap <span class='text-white font-bold italic underline decoration-red-600 underline-offset-8'>aman di dunia digital </span> melalui solusi yang <span class='text-red-500 font-extrabold uppercase tracking-widest'>produktif</span>, cerdas secara <span class='text-red-500 font-extrabold uppercase tracking-widest'>inovatif</span> dan berdampak <span class='text-red-500 font-extrabold uppercase tracking-widest'>kreatif</span> yang nyata.
              </p>
            </div>
            <div class='flex items-center gap-3'>
              <div class='w-2 h-2 rounded-full bg-red-600 animate-pulse'/>
              <span class='text-[10px] font-black uppercase tracking-[0.4em] text-white/40 italic'>Garis Depan Literasi Digital &amp; Mengatasi Kesenjangan Digital</span>
            </div>
          </div>
        </div>
      </section>
    </b:if>

    <!-- Kontainer Putih Utama -->
    <section class='bg-white text-black min-h-screen relative overflow-hidden rounded-t-[3rem] -mt-10 z-10 shadow-2xl'>
      <div class='max-w-6xl mx-auto px-6 md:px-12 py-16'>
        
        <!-- HEADER ARSIP DIGITAL / SEARCH -->
        <b:if cond='data:view.isMultipleItems'>
          <div class='flex flex-col md:flex-row justify-between items-end gap-6 border-b-2 border-black/5 pb-8 mb-8'>
            <div class='space-y-2'>
              <p class='text-[9px] font-black text-red-600 uppercase tracking-[0.5em]'>Insight &amp; Solusi</p>
              <h2 class='text-3xl md:text-4xl font-black tracking-tighter italic uppercase text-black'>
                <b:if cond='data:view.isSearch'>HASIL TELUSUR<b:else/>ARSIP TERBARU</b:if>
              </h2>
            </div>
            <div class='flex gap-4'>
              <b:if cond='data:view.isSearch or data:view.isArchive'>
                 <a class='text-[10px] font-black border-2 border-slate-200 px-6 py-2 rounded-full hover:bg-slate-100 transition-all uppercase italic tracking-tighter flex items-center gap-2' expr:href='data:blog.homepageUrl'>
                  <i data-lucide='home' style='width:12px;'/> BERANDA
                </a>
              </b:if>
              <b:if cond='!data:view.isSearch'>
                <a class='text-[10px] font-black border-2 border-black px-6 py-2 rounded-full hover:bg-black hover:text-white transition-all uppercase italic tracking-tighter' href='/search?max-results=50'>
                  JELAJAH SEMUA <i class='inline-block ml-1' data-lucide='arrow-right' style='width:12px;'/>
                </a>
              </b:if>
            </div>
          </div>
        </b:if>

        <!-- LIST POSTINGAN -->
        <b:section id='main-blog-section' showaddelement='yes'>
          <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='showDateHeader'>false</b:widget-setting>
              <b:widget-setting name='style.textcolor'>#ffffff</b:widget-setting>
              <b:widget-setting name='showShareButtons'>true</b:widget-setting>
              <b:widget-setting name='showCommentLink'>true</b:widget-setting>
              <b:widget-setting name='style.urlcolor'>#ffffff</b:widget-setting>
              <b:widget-setting name='showAuthor'>false</b:widget-setting>
              <b:widget-setting name='style.linkcolor'>#ffffff</b:widget-setting>
              <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
              <b:widget-setting name='style.bgcolor'>#ffffff</b:widget-setting>
              <b:widget-setting name='timestampLabel'/>
              <b:widget-setting name='reactionsLabel'/>
              <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
              <b:widget-setting name='style.layout'>1x1</b:widget-setting>
              <b:widget-setting name='showLabels'>true</b:widget-setting>
              <b:widget-setting name='showLocation'>false</b:widget-setting>
              <b:widget-setting name='postLabelsLabel'/>
              <b:widget-setting name='showTimestamp'>true</b:widget-setting>
              <b:widget-setting name='postsPerAd'>1</b:widget-setting>
              <b:widget-setting name='showBacklinks'>false</b:widget-setting>
              <b:widget-setting name='style.bordercolor'>#ffffff</b:widget-setting>
              <b:widget-setting name='showInlineAds'>false</b:widget-setting>
              <b:widget-setting name='showReactions'>false</b:widget-setting>
            </b:widget-settings>
            <b:includable id='main' var='top'>
              <b:if cond='data:view.isMultipleItems'>
                <!-- Layout Grid (Menampilkan 4 Berita Terbaru di Homepage) -->
                <div class='grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8'>
                  <div class='lg:col-span-7'>
                    <b:loop index='i' values='data:posts' var='post'>
                      <b:if cond='data:i == 0'>
                        <article class='group'>
                          <a class='space-y-4 block' expr:href='data:post.url'>
                            <div class='relative aspect-[16/9] overflow-hidden rounded-3xl bg-slate-100 shadow-lg'>
                              <b:if cond='data:post.featuredImage'>
                                <img class='w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000' expr:alt='data:post.title' expr:src='data:post.featuredImage'/>
                              <b:else/>
                                <div class='w-full h-full img-placeholder'><i data-lucide='image' style='width:40px; height:40px;'/></div>
                              </b:if>
                              <div class='absolute top-4 left-4'>
                                <span class='bg-black text-white text-[9px] font-black px-3 py-1 rounded-full uppercase'><b:if cond='data:post.labels'><data:post.labels.first.name/><b:else/>NEW</b:if></span>
                              </div>
                            </div>
                            <div class='space-y-2'>
                              <h3 class='text-2xl md:text-3xl font-black leading-tight tracking-tighter italic group-hover:text-red-600 transition-colors uppercase'><data:post.title/></h3>
                              <p class='text-slate-400 text-[10px] font-bold uppercase tracking-widest'><data:post.dateISO8601/></p>
                            </div>
                          </a>
                        </article>
                      </b:if>
                    </b:loop>
                  </div>
                  <div class='lg:col-span-5 flex flex-col gap-4'>
                    <!-- Looping Berita Tambahan (Indeks 1, 2, 3 - Total 4) -->
                    <b:loop index='i' values='data:posts' var='post'>
                      <b:if cond='data:i &gt; 0 and data:i &lt; 4'>
                        <article class='group flex gap-4 items-center border-b border-slate-100 pb-4'>
                          <div class='w-20 h-20 flex-shrink-0 overflow-hidden rounded-2xl bg-slate-50'>
                             <b:if cond='data:post.featuredImage'>
                              <img class='w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500' expr:src='data:post.featuredImage'/>
                             <b:else/>
                              <div class='w-full h-full img-placeholder'><i data-lucide='image' style='width:16px;'/></div>
                             </b:if>
                          </div>
                          <div class='space-y-0.5'>
                            <a class='block' expr:href='data:post.url'>
                              <p class='text-[7px] font-black text-red-600 uppercase'>
                                <b:if cond='data:post.labels'><data:post.labels.first.name/><b:else/>ARSIP</b:if>
                              </p>
                              <h4 class='text-xs font-black italic tracking-tight group-hover:text-red-600 transition-all leading-tight uppercase'><data:post.title/></h4>
                              <p class='text-[8px] text-slate-400 font-bold uppercase'><data:post.dateISO8601/></p>
                            </a>
                          </div>
                        </article>
                      </b:if>
                    </b:loop>
                    
                    <!-- Area Footer Arsip -->
                    <b:if cond='!data:view.isHomepage'>
                      <div class='mt-auto p-6 bg-slate-50 rounded-3xl border border-slate-100'>
                        <form action='/search' class='relative' method='get'>
                          <input class='w-full bg-white border-2 border-slate-200 rounded-full py-3 px-6 text-xs font-bold focus:outline-none focus:border-black transition-all' name='q' placeholder='Cari arsip pemikiran...' type='text'/>
                          <button class='absolute right-2 top-1/2 -translate-y-1/2 bg-black text-white p-2 rounded-full hover:bg-red-600 transition-all' type='submit'>
                            <i data-lucide='search' style='width:14px; height:14px;'/>
                          </button>
                        </form>
                      </div>
                    </b:if>
                  </div>
                </div>

                <!-- Halaman Hasil Telusur / Jelajah (Grid Penuh) -->
                <b:if cond='data:view.isSearch'>
                  <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-12 border-t border-slate-100'>
                     <b:loop index='i' values='data:posts' var='post'>
                         <article class='group space-y-4'>
                           <a class='block' expr:href='data:post.url'>
                             <div class='aspect-video rounded-2xl overflow-hidden bg-slate-100 mb-4'>
                               <b:if cond='data:post.featuredImage'>
                                 <img class='w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all' expr:src='data:post.featuredImage'/>
                               <b:else/>
                                 <div class='w-full h-full img-placeholder'><i data-lucide='image' style='width:20px;'/></div>
                               </b:if>
                             </div>
                             <p class='text-[8px] font-black text-red-600 uppercase'><b:if cond='data:post.labels'><data:post.labels.first.name/><b:else/>LOG</b:if></p>
                             <h4 class='font-black italic uppercase text-sm group-hover:text-red-600 transition-all'><data:post.title/></h4>
                           </a>
                         </article>
                     </b:loop>
                  </div>
                </b:if>

              <b:else/>
                <!-- Tampilan Single Post atau Static Page -->
                <b:loop values='data:posts' var='post'>
                  <article class='max-w-3xl mx-auto mb-12'>
                    
                    <div class='mb-6 space-y-4'>
                      <div class='flex items-center gap-3 text-[10px] font-bold text-slate-400 uppercase tracking-widest'>
                        <span class='text-red-600 font-black'>
                          <b:if cond='data:view.isPage'>HALAMAN<b:else/><b:if cond='data:post.labels'><data:post.labels.first.name/><b:else/>LOG</b:if></b:if>
                        </span>
                        <span class='w-6 h-[1px] bg-slate-200'/>
                        <span><data:post.dateISO8601/></span>
                      </div>
                      <h1 class='text-2xl md:text-4xl font-black tracking-tighter uppercase leading-tight'><data:post.title/></h1>
                    </div>
                    
                    <div class='post-body entry-content'>
                      <data:post.body/>
                    </div>
                  </article>
                </b:loop>
              </b:if>
            </b:includable>
            <b:includable id='aboutPostAuthor'>
  <div class='author-name'>
    <a class='g-profile' expr:href='data:post.author.profileUrl' rel='author' title='author profile'>
      <span>
        <data:post.author.name/>
      </span>
    </a>
  </div>
  <div>
    <span class='author-desc'>
      <data:post.author.aboutMe/>
    </span>
  </div>
</b:includable>
            <b:includable id='addComments'>
  <a expr:href='data:post.commentsUrl' expr:onclick='data:post.commentsUrlOnclick'>
    <b:message name='messages.postAComment'/>
  </a>
</b:includable>
            <b:includable id='blogThisShare'>
  <b:with value='&quot;window.open(this.href, \&quot;_blank\&quot;, \&quot;height=270,width=475\&quot;); return false;&quot;' var='onclick'>
    <b:include name='platformShare'/>
  </b:with>
</b:includable>
            <b:includable id='bylineByName' var='byline'>
  <b:switch var='data:byline.name'>
  <b:case value='share'/>
    <b:include cond='data:post.shareUrl' name='postShareButtons'/>
  <b:case value='comments'/>
    <b:include cond='data:post.allowComments' name='postCommentsLink'/>
  <b:case value='location'/>
    <b:include cond='data:post.location' name='postLocation'/>
  <b:case value='timestamp'/>
    <b:include cond='not data:view.isPage' name='postTimestamp'/>
  <b:case value='author'/>
    <b:include name='postAuthor'/>
  <b:case value='labels'/>
    <b:include cond='data:post.labels' name='postLabels'/>
  <b:case value='icons'/>
    <b:include cond='data:post.emailPostUrl' name='emailPostIcon'/>
  </b:switch>
</b:includable>
            <b:includable id='bylineRegion' var='regionItems'>
  <b:loop values='data:regionItems' var='byline'>
    <b:include data='byline' name='bylineByName'/>
  </b:loop>
</b:includable>
            <b:includable id='commentAuthorAvatar'>
  <div class='avatar-image-container'>
    <img class='author-avatar' expr:src='data:comment.authorAvatarSrc' height='35' width='35'/>
  </div>
</b:includable>
            <b:includable id='commentDeleteIcon' var='comment'>
  <span expr:class='&quot;item-control &quot; + data:comment.adminClass'>
    <b:if cond='data:showCmtPopup'>
      <div class='goog-toggle-button'>
        <div class='goog-inline-block comment-action-icon'/>
      </div>
    <b:else/>
      <a class='comment-delete' expr:href='data:comment.deleteUrl' expr:title='data:messages.deleteComment'>
        <img src='https://resources.blogblog.com/img/icon_delete13.gif'/>
      </a>
    </b:if>
  </span>
</b:includable>
            <b:includable id='commentForm' var='post'>
  <div class='comment-form'>
    <a name='comment-form'/>
    <h4 id='comment-post-message'><data:messages.postAComment/></h4>
    <b:if cond='data:this.messages.blogComment != &quot;&quot;'>
      <p><data:this.messages.blogComment/></p>
    </b:if>
    <b:include data='post' name='commentFormIframeSrc'/>
    <iframe allowtransparency='allowtransparency' class='blogger-iframe-colorize blogger-comment-from-post' expr:height='data:cmtIframeInitialHeight ?: &quot;90px&quot;' frameborder='0' id='comment-editor' name='comment-editor' src='' width='100%'/>
    <data:post.cmtfpIframe/>
    <script type='text/javascript'>
      BLOG_CMT_createIframe(&#39;<data:post.appRpcRelayPath/>&#39;);
    </script>
  </div>
</b:includable>
            <b:includable id='commentFormIframeSrc' var='post'>
  <a expr:href='data:post.commentFormIframeSrc' id='comment-editor-src'/>
</b:includable>
            <b:includable id='commentItem' var='comment'>
  <div class='comment' expr:id='&quot;c&quot; + data:comment.id'>
    <b:include cond='data:blog.enabledCommentProfileImages' name='commentAuthorAvatar'/>

    <div class='comment-block'>
      <div class='comment-author'>
        <b:if cond='data:comment.authorUrl'>
          <b:message name='messages.authorSaidWithLink'>
            <b:param expr:value='data:comment.author' name='authorName'/>
            <b:param expr:value='data:comment.authorUrl' name='authorUrl'/>
          </b:message>
        <b:else/>
          <b:message name='messages.authorSaid'>
            <b:param expr:value='data:comment.author' name='authorName'/>
          </b:message>
        </b:if>
      </div>
      <div expr:class='&quot;comment-body&quot; + (data:comment.isDeleted ? &quot; deleted&quot; : &quot;&quot;)'>
        <data:comment.body/>
      </div>
      <div class='comment-footer'>
        <span class='comment-timestamp'>
          <a expr:href='data:comment.url' title='comment permalink'>
            <data:comment.timestamp/>
          </a>
          <b:include data='comment' name='commentDeleteIcon'/>
        </span>
      </div>
    </div>
  </div>
</b:includable>
            <b:includable id='commentList' var='comments'>
  <div id='comments-block'>
    <b:loop values='data:comments' var='comment'>
      <b:include data='comment' name='commentItem'/>
    </b:loop>
  </div>
</b:includable>
            <b:includable id='commentPicker' var='post'>
  <b:if cond='data:post.showThreadedComments'>
    <b:include data='post' name='threadedComments'/>
  <b:else/>
    <b:include data='post' name='comments'/>
  </b:if>
</b:includable>
            <b:includable id='comments' var='post'>
  <section expr:class='&quot;comments&quot; + (data:post.embedCommentForm ? &quot; embed&quot; : &quot;&quot;)' expr:data-num-comments='data:post.numberOfComments' id='comments'>
    <a name='comments'/>
    <b:if cond='data:post.allowComments'>

      <b:include name='commentsTitle'/>

      <div expr:id='data:widget.instanceId + &quot;_comments-block-wrapper&quot;'>
        <b:include cond='data:post.comments' data='post.comments' name='commentList'/>
      </div>

      <b:if cond='data:post.commentPagingRequired'>
        <div class='paging-control-container'>
          <b:if cond='data:post.hasOlderLinks'>
            <a expr:class='data:post.oldLinkClass' expr:href='data:post.oldestLinkUrl'>
              <data:messages.oldest/>
            </a>
            <a expr:class='data:post.oldLinkClass' expr:href='data:post.olderLinkUrl'>
              <data:messages.older/>
            </a>
          </b:if>

          <span class='comment-range-text'>
            <data:post.commentRangeText/>
          </span>

          <b:if cond='data:post.hasNewerLinks'>
            <a expr:class='data:post.newLinkClass' expr:href='data:post.newerLinkUrl'>
              <data:messages.newer/>
            </a>
            <a expr:class='data:post.newLinkClass' expr:href='data:post.newestLinkUrl'>
              <data:messages.newest/>
            </a>
          </b:if>
        </div>
      </b:if>

      <div class='footer'>
        <b:if cond='data:post.embedCommentForm'>
          <b:if cond='data:post.allowNewComments'>
            <b:include data='post' name='commentForm'/>
