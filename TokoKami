                    <span class='text-sm text-gray-300 font-bold line-through block' id='modal-old-price'/>
                    <span class='text-4xl font-black text-emerald-600' id='modal-price'/>
                </div>
                <div class='flex-grow overflow-y-auto custom-scroll text-gray-500 mb-8 whitespace-pre-line text-sm' id='modal-description'/>
                <a class='w-full py-6 bg-emerald-600 text-white rounded-[1.8rem] font-black text-center shadow-xl' href='#' id='modal-wa-button'>Pesan Sekarang</a>
