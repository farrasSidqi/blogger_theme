    <script type='text/javascript'>//<![CDATA[
        const WA_NUMBER = "628123456789";

        // Fungsi Filter Pencarian (LIVE SEARCH)
        function filterBloggerItems() {
            const input = document.getElementById('live-search').value.toLowerCase();
            const cards = document.querySelectorAll('.product-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const title = card.dataset.title ? card.dataset.title.toLowerCase() : "";
                if (title.includes(input)) {
                    card.style.display = "flex";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            });
            document.getElementById('product-count-badge').innerText = `Total Produk : ${visibleCount}`;
        }

        function processBloggerPosts() {
            document.querySelectorAll('.product-card:not(.is-processed)').forEach(card => {
                const rawEl = card.querySelector('.post-raw-content');
                if(!rawEl) return;
                
                let rawHTML = rawEl.innerHTML;

                const price = (rawHTML.match(/\[price\](.*?)\[\/price\]/i) || [null, "Hubungi Kami"])[1];
                const old = (rawHTML.match(/\[old\](.*?)\[\/old\]/i) || [null, ""])[1];
                const label = (rawHTML.match(/\[label\](.*?)\[\/label\]/i) || [null, ""])[1];
                const color = (rawHTML.match(/\[label-color\](.*?)\[\/label-color\]/i) || [null, "green"])[1].toLowerCase();
                
                let images = [];
                rawEl.querySelectorAll('img').forEach(img => images.push(img.src));
                if(images.length === 0 && card.querySelector('img')) images.push(card.querySelector('img').src);

                let tempDiv = document.createElement('div');
                tempDiv.innerHTML = rawHTML;
                tempDiv.querySelectorAll('img').forEach(i => i.remove());
                
                let cleanText = tempDiv.innerHTML
                    .replace(/\[price\].*?\[\/price\]/gi, '')
                    .replace(/\[old\].*?\[\/old\]/gi, '')
                    .replace(/\[label\].*?\[\/label\]/gi, '')
                    .replace(/\[label-color\].*?\[\/label-color\]/gi, '')
                    .replace(/&nbsp;/g, ' ')
                    .replace(/<[^>]*>?/gm, '')
                    .replace(/\s+/g, ' ')
                    .trim();

                card.dataset.price = price;
                card.dataset.old = old;
                card.dataset.desc = cleanText;
                card.dataset.images = JSON.stringify(images);

                card.querySelector('.price-display').innerText = price.includes("Hubungi") ? price : `Rp ${price}`;
                if (old) {
                    const op = card.querySelector('.old-price-display');
                    op.innerText = `Rp ${old}`; op.classList.remove('hidden');
                }
                if (label) {
                    const colors = {'merah':'label-red','kuning':'label-yellow','hitam':'label-black'};
                    card.querySelector('.label-placeholder').innerHTML = `<span class="${colors[color]||'label-green'} text-white px-3 py-1 rounded-xl text-[8px] font-black uppercase shadow-lg">${label}</span>`;
                }
                card.classList.add('is-processed');
            });
            
            // Update jumlah awal produk saat halaman dimuat
            if(!document.getElementById('live-search').value) {
               document.getElementById('product-count-badge').innerText = `Total Produk : ${document.querySelectorAll('.product-card').length}`;
            }
        }

        function openDetailModal(el) {
            const d = el.dataset;
            const images = JSON.parse(d.images || "[]");
            const m = document.getElementById('product-modal');
            
            document.getElementById('modal-title').innerText = el.querySelector('h3').innerText;
            document.getElementById('modal-price').innerText = d.price.includes("Hubungi") ? d.price : "Rp " + d.price;
            document.getElementById('modal-old-price').innerText = d.old ? "Rp " + d.old : "";
            document.getElementById('modal-description').innerText = d.desc;
            
            const mainImg = document.getElementById('modal-main-img');
            const thumbArea = document.getElementById('modal-thumbs-area');
            
            if(images.length > 0) {
                mainImg.src = images[0];
                thumbArea.innerHTML = "";
                if(images.length > 1) {
                    images.forEach((src, i) => {
                        const t = document.createElement('img');
                        t.src = src;
                        t.className = `w-14 h-14 object-cover rounded-xl cursor-pointer border-2 border-transparent opacity-50 hover:opacity-100 ${i===0?'thumb-active':''}`;
                        t.onclick = () => {
                            mainImg.src = src;
                            thumbArea.querySelectorAll('img').forEach(img => img.classList.remove('thumb-active'));
                            t.classList.add('thumb-active');
                        };
                        thumbArea.appendChild(t);
                    });
                }
            }

            const waMsg = `Halo Admin, saya tertarik: *${el.querySelector('h3').innerText}* (Rp ${d.price})`;
            document.getElementById('modal-wa-button').href = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(waMsg)}`;
            m.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeAllModals() { 
            document.getElementById('product-modal').classList.add('hidden'); 
            document.body.style.overflow = 'auto';
        }

        window.onload = () => { 
            if (window.location.pathname.includes('/p/')) document.body.classList.add('is-static-page');
            processBloggerPosts(); 
            setInterval(processBloggerPosts, 1500); 
        };
    //]]></script>
