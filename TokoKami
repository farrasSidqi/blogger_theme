            <button class='absolute top-7 right-7 z-50 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg' onclick='closeAllModals()'><i class='fa-solid fa-xmark'/></button>
            <div class='w-full md:w-1/2 bg-gray-50 p-8 flex flex-col items-center'>
                <img class='max-h-[350px] object-contain mb-6' id='modal-main-img' src=''/>
